---
import AppIcon from './AppIcon.astro'
import { t, path, formatDate, categories, platformNames, type Locale } from '../lib/i18n'
import { displayName, tagline, latestAny, type Software } from '../lib/software'

interface Props {
  locale: Locale
  items: Software[]
}

const { locale, items } = Astro.props
---

{
  items.length === 0 ? (
    <p class="empty">{t(locale, 'empty.software.title')}</p>
  ) : (
    <ul class="index" role="list">
      {items.map((software) => {
        const release = latestAny(software)
        return (
          <li data-category={software.data.category}>
            <a class="card" href={path(locale, `software/${software.id}`)}>
              <div class="content">
                <div class="card-heading">
                  <AppIcon software={software} size={52} />
                  <div>
                    <p class="category">{categories[software.data.category][locale]}</p>
                    <h3>{displayName(software, locale)}</h3>
                  </div>
                  <span class="card-arrow" aria-hidden="true"></span>
                </div>
                <p class="tagline">{tagline(software, locale)}</p>
                <div class="facts">
                  <span>{software.data.platforms.map((platform) => platformNames[platform]).join(' · ')}</span>
                  {release && (
                    <span class="release num">
                      v{release.version}
                      <time datetime={release.date.toISOString().slice(0, 10)}>{formatDate(release.date, locale)}</time>
                    </span>
                  )}
                </div>
              </div>
            </a>
          </li>
        )
      })}
    </ul>
  )
}

<style>
  .index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.9rem, 2.2vw, 1.6rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 160ms ease;
  }
  .card:hover, .card:focus-visible {
    border-color: var(--link);
  }
  .content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.95rem;
    padding: clamp(1.05rem, 2.5vw, 1.55rem);
  }
  .card-heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
  }
  .category {
    color: var(--ink-soft);
    font-size: 0.78rem;
    font-weight: 690;
  }
  h3 {
    font-size: clamp(1.35rem, 2.6vw, 1.82rem);
    text-wrap: initial;
  }
  .card-arrow {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink);
    transition: color 160ms ease, background 160ms ease, border-color 160ms ease;
  }
  .card-arrow::after {
    content: '';
    width: 0.78rem;
    aspect-ratio: 1;
    background: currentColor;
    clip-path: polygon(0 88%, 12% 100%, 83% 29%, 83% 77%, 100% 77%, 100% 0, 23% 0, 23% 17%, 71% 17%);
  }
  .card:hover .card-arrow, .card:focus-visible .card-arrow {
    border-color: var(--action);
    background: var(--action);
    color: var(--on-action);
  }
  .tagline {
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .facts, .release {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.7rem;
  }
  .facts {
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: 0.78rem;
    font-weight: 650;
  }
  .empty {
    padding: 2rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    color: var(--ink-soft);
  }
  @media (max-width: 700px) {
    .index {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
