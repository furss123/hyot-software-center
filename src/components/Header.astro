---
import { t, path, type Locale } from '../lib/i18n'

interface Props {
  locale: Locale
  altPath: string
}

const { locale, altPath } = Astro.props
---

<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href={path(locale)} aria-label="HyoT">
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="logo-word">HyoT</span>
    </a>
    <div class="tools">
      <a class="lang" href={altPath} hreflang={locale === 'ko' ? 'en' : 'ko'}>{t(locale, 'nav.lang')}</a>
      <button class="theme" type="button" aria-label={t(locale, 'nav.theme')} title={t(locale, 'nav.theme')}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.site-header .theme')
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
    document.documentElement.dataset.theme = next
    try {
      localStorage.setItem('theme', next)
    } catch {}
  })
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 4.5rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    text-decoration: none;
  }
  .logo-mark {
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 5px;
    background: #16223d;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
    position: relative;
    overflow: hidden;
  }
  .logo-mark::after {
    content: '';
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: 18%;
    height: 34%;
    background: var(--mark);
    transform: rotate(-8deg);
  }
  .logo-word {
    font-size: 1.3rem;
    font-weight: 880;
    letter-spacing: -0.04em;
  }
  .tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .lang {
    color: var(--ink-soft);
    font-size: var(--t-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .lang:hover {
    color: var(--ink);
  }
  .theme {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .theme:hover {
    border-color: var(--ink-soft);
  }
</style>
