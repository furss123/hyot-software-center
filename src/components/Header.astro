---
import { t, path, type Locale } from '../lib/i18n'

interface Props {
  locale: Locale
  current?: string
  altPath: string
}

const { locale, current, altPath } = Astro.props
const items = [
  { key: 'software', label: t(locale, 'nav.software'), href: path(locale, 'software') },
  { key: 'changelog', label: t(locale, 'nav.changelog'), href: path(locale, 'changelog') },
  { key: 'feedback', label: t(locale, 'nav.feedback'), href: path(locale, 'feedback') },
]
---

<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href={path(locale)} aria-label="HyoT">
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="logo-word">HyoT</span>
    </a>
    <nav aria-label={locale === 'ko' ? '주 메뉴' : 'Main'}>
      <ul>
        {
          items.map((it) => (
            <li>
              <a
                href={it.href}
                class:list={['nav-link', { active: current === it.key }]}
                aria-current={current === it.key ? 'page' : undefined}
              >
                <span class="mark-stroke">{it.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="tools">
      <a class="lang" href={altPath} hreflang={locale === 'ko' ? 'en' : 'ko'}>{t(locale, 'nav.lang')}</a>
      <button class="theme" type="button" aria-label={t(locale, 'nav.theme')} title={t(locale, 'nav.theme')}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.site-header .theme')
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
    document.documentElement.dataset.theme = next
    try {
      localStorage.setItem('theme', next)
    } catch {}
  })
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    min-height: 4.5rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    text-decoration: none;
  }
  .logo-mark {
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 5px;
    background: #16223d;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
    position: relative;
    overflow: hidden;
  }
  .logo-mark::after {
    content: '';
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: 18%;
    height: 34%;
    background: var(--mark);
    transform: rotate(-8deg);
  }
  .logo-word {
    font-size: 1.3rem;
    font-weight: 880;
    letter-spacing: -0.04em;
  }
  nav {
    flex: 1;
  }
  nav ul {
    display: flex;
    gap: clamp(0.9rem, 2.4vw, 2rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }
  .nav-link:hover .mark-stroke,
  .nav-link:focus-visible .mark-stroke,
  .nav-link.active .mark-stroke {
    background-size: 100% 0.42em;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .lang {
    color: var(--ink-soft);
    font-size: var(--t-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .lang:hover {
    color: var(--ink);
  }
  .theme {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .theme:hover {
    border-color: var(--ink-soft);
  }
  @media (max-width: 640px) {
    .bar {
      flex-wrap: wrap;
      row-gap: 0;
      padding-top: 0.5rem;
    }
    .tools {
      margin-left: auto;
    }
    nav {
      order: 3;
      flex-basis: 100%;
      overflow-x: auto;
      padding-block: 0.4rem 0.8rem;
    }
  }
</style>
