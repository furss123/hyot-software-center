---
import Brand from './Brand.astro'
import { t, path, otherLocale, type Locale } from '../lib/i18n'

interface Props {
  locale: Locale
  altPath: string
}

const { locale, altPath } = Astro.props
const home = path(locale)
const clockPage = path(locale, 'clock')
const schoolPage = path(locale, 'today-school')
const pdfPage = path(locale, 'moagyeol-pdf')
const onHome = Astro.url.pathname === home
const altLocale = otherLocale(locale)
---

<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href={home}>
      <Brand />
    </a>
    <nav aria-label={t(locale, 'nav.label')}>
      <a href={pdfPage} class:list={{ current: Astro.url.pathname === pdfPage }}
        aria-current={Astro.url.pathname === pdfPage ? 'page' : undefined}>
        {t(locale, 'nav.pdf')}
      </a>
      <a href={schoolPage} class:list={{ current: Astro.url.pathname === schoolPage }}
        aria-current={Astro.url.pathname === schoolPage ? 'page' : undefined}>
        {t(locale, 'nav.school')}
      </a>
      <a href={clockPage} class:list={{ current: Astro.url.pathname === clockPage }}
        aria-current={Astro.url.pathname === clockPage ? 'page' : undefined}>
        {t(locale, 'nav.clockWeb')}
      </a>
      <a href={onHome ? '#utilities' : `${home}#utilities`} class:list={{ current: onHome }}>
        {t(locale, 'home.catalog')}
      </a>
    </nav>
    <div class="tools">
      <a class="lang" href={altPath} lang={altLocale} hreflang={altLocale}>{t(locale, 'nav.lang')}</a>
      <button class="theme" type="button" aria-label={t(locale, 'nav.theme')} title={t(locale, 'nav.theme')}>
        <span class="theme-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.site-header .theme')
  const root = document.documentElement
  button?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'))
  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
    root.dataset.theme = next
    button.setAttribute('aria-pressed', String(next === 'dark'))
    try {
      localStorage.setItem('theme', next)
    } catch {}
  })
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
    min-height: 4.5rem;
  }
  .logo {
    display: inline-flex;
    justify-self: start;
    text-decoration: none;
    border-radius: 0.65rem;
  }
  nav, .tools {
    display: flex;
    gap: clamp(0.25rem, 1.5vw, 1rem);
    align-items: center;
  }
  .tools {
    justify-self: end;
  }
  nav a, .lang {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.68rem;
    border-radius: 0.55rem;
    color: var(--ink-soft);
    font-size: var(--t-sm);
    font-weight: 680;
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover, .lang:hover, nav .current {
    color: var(--ink);
    background: var(--surface-toned);
  }
  .theme {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border-radius: 0.65rem;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }
  .theme:hover {
    background: var(--surface-toned);
  }
  .theme-icon {
    width: 1rem;
    height: 1rem;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
    transform: rotate(-25deg);
  }
  :global([data-theme='dark']) .theme-icon {
    transform: rotate(155deg);
  }
  @media (max-width: 1200px) {
    .bar {
      grid-template-columns: 1fr auto;
      padding-top: 0.55rem;
      gap: 0.25rem;
    }
    nav {
      grid-area: 2 / 1 / 3 / -1;
      flex-wrap: wrap;
      gap: 0.15rem 0.3rem;
      border-top: 1px solid var(--line);
      padding-block: 0.25rem;
    }
    nav a {
      padding-inline: 0.45rem;
    }
    .tools {
      grid-area: 1 / 2;
    }
  }
</style>
