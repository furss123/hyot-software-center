---
import { Image } from 'astro:assets'
import type { Software } from '../lib/software'

interface Props {
  software: Software
  size?: number
}
const { software, size = 56 } = Astro.props
const icon = software.data.icon
const letter = software.data.name.replace(/^Hyo/i, '').charAt(0).toUpperCase() || 'H'
---

{
  icon ? (
    <Image src={icon} alt="" width={size * 2} height={size * 2} class="app-icon" style={`--s:${size}px`} />
  ) : (
    <span class="app-icon placeholder" style={`--s:${size}px`} aria-hidden="true">
      {letter}
    </span>
  )
}

<style>
  .app-icon {
    width: var(--s);
    height: var(--s);
    border-radius: 22%;
    flex: none;
    object-fit: cover;
  }
  .placeholder {
    display: grid;
    place-items: center;
    background: #16223d;
    color: #ffe24a;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    font-weight: 860;
    font-size: calc(var(--s) * 0.48);
    letter-spacing: -0.04em;
  }
</style>
