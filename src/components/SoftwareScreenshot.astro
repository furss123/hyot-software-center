---
import { Image, getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  image: ImageMetadata
  title: string
  fullSizeLabel: string
}

const { image, title, fullSizeLabel } = Astro.props
const widths = [480, 720].filter((width) => width < image.width).concat(image.width)
const fullSize = await getImage({ src: image, format: 'png', width: image.width })
---

<a class="preview" href={fullSize.src} target="_blank" rel="noopener" aria-label={`${title} · ${fullSizeLabel}`}>
  <figure>
    <Image
      src={image}
      alt=""
      widths={widths}
      sizes="(max-width: 700px) calc(100vw - 2rem), 375px"
      format="webp"
      quality={90}
      loading="lazy"
    />
    <figcaption>
      <span>{title}</span>
      <span class="full-size" aria-hidden="true">↗</span>
    </figcaption>
  </figure>
</a>

<style>
  .preview {
    display: block;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 160ms ease;
  }
  .preview:hover {
    border-color: var(--link);
  }
  figure {
    margin: 0;
  }
  img {
    width: 100%;
    aspect-ratio: 1.4;
    padding: 0.75rem;
    background: var(--surface-toned);
    object-fit: contain;
  }
  figcaption {
    display: flex;
    gap: 0.5rem;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 0.85rem;
    font-size: var(--t-sm);
    font-weight: 690;
  }
  .full-size {
    color: var(--link);
    font-family: system-ui;
  }
</style>
