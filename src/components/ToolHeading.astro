---
// 웹 도구 페이지(모아결 PDF, 오늘 학교, 시험용 시계)가 함께 쓰는 페이지 머리.
// 제목 크기, 설명 문구, 오른쪽 다운로드 버튼 모양을 세 페이지에서 똑같이 맞춘다.
interface Props {
  id: string
  title: string
  description?: string
  action?: { href: string; label: string }
}

const { id, title, description, action } = Astro.props
---

<header class="tool-heading">
  <div>
    <h1 id={id}>{title}</h1>
    {description && <p>{description}</p>}
  </div>
  {
    action && (
      <a class="btn btn-sm" href={action.href}>
        {action.label} <span aria-hidden="true">↓</span>
      </a>
    )
  }
</header>

<style>
  .tool-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.9rem 1.25rem;
    margin-bottom: clamp(1.1rem, 3vw, 1.75rem);
  }
  h1 {
    font-size: var(--t-page);
    letter-spacing: -0.065em;
  }
  p {
    max-width: 40em;
    margin-top: 0.55rem;
    color: var(--ink-soft);
    font-size: clamp(1rem, 2vw, 1.15rem);
  }
</style>
