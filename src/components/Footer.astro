---
import Brand from './Brand.astro'
import { path, t, type Locale } from '../lib/i18n'
import { contact } from '../lib/site'

interface Props { locale: Locale }
const { locale } = Astro.props
const year = new Date().getUTCFullYear()
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <a class="logo" href={path(locale)}><Brand /></a>
    <div class="footer-end">
      <nav class="footer-links" aria-label={t(locale, 'footer.label')}>
        <a href={path(locale, 'privacy')}>{t(locale, 'footer.privacy')}</a>
        <a href={`mailto:${contact.email}`}>
          <span class="muted">{t(locale, 'footer.contact')}</span> {contact.email}
        </a>
        <a href={contact.repo}>GitHub</a>
      </nav>
      <p class="muted">© {year} hyot.dev</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(3rem, 8vw, 6rem);
    border-top: 1px solid var(--line);
    padding-block: 1rem;
    font-size: var(--t-sm);
  }
  .footer-inner,
  .footer-end,
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .footer-inner {
    justify-content: space-between;
    gap: 0.5rem 1.8rem;
  }
  .footer-end {
    gap: 0 1.8rem;
  }
  .footer-links {
    gap: 0 1.2rem;
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    color: var(--ink);
    text-decoration: none;
  }
  .footer-links a:hover {
    color: var(--link);
    text-decoration: underline;
  }
  .logo {
    text-decoration: none;
  }
  .logo :global(img) {
    width: 1.7rem;
  }
</style>
