---
import { Image } from 'astro:assets'
import AppIcon from './AppIcon.astro'
import type { Software } from '../lib/software'

interface Props {
  software: Software
  featured?: boolean
}

const { software, featured = false } = Astro.props
const cover = software.data.cover
---

<div class:list={['cover', { featured }]}>
  {
    cover ? (
      <Image
        src={cover}
        alt=""
        widths={[480, 760, 1200].filter((width) => width < cover.width).concat(cover.width)}
        sizes="(max-width: 700px) calc(100vw - 2rem), 570px"
        format="webp"
        quality={82}
        loading={featured ? 'eager' : 'lazy'}
        fetchpriority={featured ? 'high' : undefined}
      />
    ) : <AppIcon software={software} size={96} loading={featured ? 'eager' : 'lazy'} />
  }
</div>

<style>
  .cover {
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    aspect-ratio: 2.18;
    background: var(--surface-toned);
  }
  .cover.featured {
    aspect-ratio: 1.5;
  }
  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    transition: transform 260ms ease;
  }
</style>
