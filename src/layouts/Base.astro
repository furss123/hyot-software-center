---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { t, path, otherLocale, type Locale } from '../lib/i18n'

interface Props {
  locale: Locale
  title?: string
  description?: string
  image?: string
  presentation?: boolean
  ads?: boolean
  // 검색엔진용 구조화 데이터(schema.org). 페이지마다 SoftwareApplication 등을 넘긴다.
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  // 홈 화면에 설치할 수 있는 웹 앱 페이지의 매니페스트 주소와 iOS 홈 화면 아이콘
  manifest?: string
  appleTouchIcon?: string
}

const {
  locale,
  title,
  description,
  image,
  presentation = false,
  ads = true,
  jsonLd,
  manifest,
  appleTouchIcon = '/apple-touch-icon.png',
} = Astro.props
const showAds = !presentation && ads
const site = 'hyot.dev'
const fullTitle = title ? `${title} | ${site}` : site
const desc = description ?? t(locale, 'site.description')
const canonical = new URL(Astro.url.pathname, Astro.site)
const localized = /^\/(ko|en)\//.test(Astro.url.pathname)
const alternateLocale = otherLocale(locale)
const altPath = localized
  ? Astro.url.pathname.replace(/^\/(ko|en)\//, `/${alternateLocale}/`)
  : path(alternateLocale)
const ogImage = new URL(image ?? '/og.png', Astro.site)
// 언어를 고르지 않은 방문자(x-default)에게는 한국어 페이지를 보여 준다.
const koreanUrl = locale === 'ko' ? canonical : new URL(altPath, Astro.site)
// </script> 같은 문자열이 스크립트를 끝내지 않도록 <를 이스케이프한다.
const structuredData = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c')
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {localized ? (
      <>
        <link rel="alternate" hreflang={locale} href={canonical} />
        <link rel="alternate" hreflang={alternateLocale} href={new URL(altPath, Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={koreanUrl} />
      </>
    ) : <meta name="robots" content="noindex" />}
    {manifest && <link rel="manifest" href={manifest} />}
    {structuredData && <script type="application/ld+json" is:inline set:html={structuredData} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href={appleTouchIcon} />
    <meta name="theme-color" content="#f6f5ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111a15" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    {showAds && <meta name="google-adsense-account" content="ca-pub-9694429813677076" />}
    <script is:inline>
      (() => {
        let saved
        try {
          saved = localStorage.getItem('theme')
        } catch {}
        const preferred = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        document.documentElement.dataset.theme = saved === 'dark' || saved === 'light' ? saved : preferred
      })()
    </script>
    {showAds && (
      <script
        is:inline
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9694429813677076"
        crossorigin="anonymous"></script>
    )}
  </head>
  <body class:list={{ presentation }}>
    {!presentation && (
      <>
        <a class="skip" href="#main">{locale === 'ko' ? '본문으로 건너뛰기' : 'Skip to content'}</a>
        <Header locale={locale} altPath={altPath} />
      </>
    )}
    <main id="main">
      <slot />
    </main>
    {!presentation && <Footer locale={locale} />}
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  body.presentation {
    min-height: 100dvh;
  }
  main {
    flex: 1;
  }
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 10;
    background: var(--mark);
    color: var(--mark-ink);
    padding: 0.6rem 1rem;
    border-radius: 8px;
    font-weight: 700;
  }
  .skip:focus {
    top: 1rem;
  }
</style>
