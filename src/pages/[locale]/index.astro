---
import { Image } from 'astro:assets'
import Base from '../../layouts/Base.astro'
import SoftwareIndex from '../../components/SoftwareIndex.astro'
import schoolScreen from '../../content/software/today-meal/cover.webp'
import { t, path, localeStaticPaths, type Locale } from '../../lib/i18n'
import { getSoftware } from '../../lib/software'

export const getStaticPaths = localeStaticPaths

const locale = Astro.params.locale as Locale
const items = await getSoftware()
const webTools = [
  { href: path(locale, 'moagyeol-pdf'), title: t(locale, 'nav.pdf'), text: t(locale, 'home.pdfWeb') },
  { href: path(locale, 'today-school'), title: t(locale, 'nav.school'), text: t(locale, 'home.schoolWeb') },
  { href: path(locale, 'clock'), title: t(locale, 'nav.clock'), text: t(locale, 'clock.description') },
]
---

<Base locale={locale}>
  <div class="wrap landing">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">
          {t(locale, 'home.titleFirst')}
          <span>{t(locale, 'home.titleSecond')}</span>
        </h1>
        <p>{t(locale, 'home.description')}</p>
        <a class="btn btn-primary" href="#utilities">
          {t(locale, 'home.browse')} <span aria-hidden="true">↓</span>
        </a>
      </div>
      <a class="hero-art" href={path(locale, 'today-school')} aria-label={t(locale, 'home.schoolOpen')}>
        <Image
          src={schoolScreen}
          alt={t(locale, 'home.schoolPreview')}
          widths={[480, 760, 1200]}
          sizes="(max-width: 760px) calc(100vw - 2rem), 580px"
          format="webp"
          quality={83}
          loading="eager"
          fetchpriority="high"
        />
      </a>
    </section>

    <section class="catalog" id="utilities" aria-labelledby="catalog-title">
      <h2 id="catalog-title">{t(locale, 'home.catalog')}</h2>
      <SoftwareIndex locale={locale} items={items} />
    </section>

    <section class="catalog web" aria-labelledby="web-title">
      <h2 id="web-title">{t(locale, 'home.web')}</h2>
      <ul class="web-list" role="list">
        {
          webTools.map((tool) => (
            <li>
              <a class="web-link" href={tool.href}>
                <span>
                  <strong>{tool.title}</strong>
                  <span class="web-text">{tool.text}</span>
                </span>
                <span class="arrow-badge small" aria-hidden="true"></span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  .landing {
    padding-top: clamp(1.15rem, 3vw, 2.4rem);
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(2rem, 4.75vw, 4.25rem);
  }
  h1 {
    font-size: clamp(2.65rem, 5.35vw, 5.1rem);
    line-height: 1.02;
    letter-spacing: -0.075em;
    text-wrap: initial;
  }
  h1:lang(en) {
    font-size: clamp(2.35rem, 4.6vw, 4.2rem);
  }
  h1 span {
    display: block;
    color: var(--link);
  }
  .hero-copy p {
    max-width: 27em;
    margin-block: clamp(1rem, 2.25vw, 1.8rem) clamp(1.35rem, 2.5vw, 2rem);
    color: var(--ink-soft);
    font-size: clamp(0.95rem, 1.5vw, 1.14rem);
    line-height: 1.55;
  }
  .hero-art {
    display: grid;
    align-items: center;
    padding: clamp(1rem, 3vw, 2rem);
    background: var(--surface-toned);
    color: var(--ink);
    text-decoration: none;
  }
  .hero-art img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: .75rem;
  }
  .hero-art:focus-visible { outline-offset: -4px; }
  .catalog {
    margin-top: clamp(2.5rem, 5vw, 4.3rem);
    scroll-margin-top: 1.5rem;
  }
  h2 {
    font-size: var(--t-lg);
  }
  .catalog h2 {
    margin-bottom: 1.12rem;
  }
  .web {
    margin-top: clamp(2.2rem, 4.5vw, 3.6rem);
  }
  .web-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .web-link {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    height: 100%;
    padding: clamp(1rem, 2.4vw, 1.4rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 160ms ease;
  }
  .web-link:hover, .web-link:focus-visible {
    border-color: var(--link);
  }
  .web-link strong {
    display: block;
    font-size: 1.12rem;
    letter-spacing: -0.03em;
  }
  .web-text {
    display: block;
    margin-top: 0.25rem;
    color: var(--ink-soft);
    font-size: var(--t-sm);
    line-height: 1.5;
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-copy {
      padding: clamp(1.4rem, 5.5vw, 2.5rem);
    }
  }
  @media (max-width: 900px) {
    .web-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
