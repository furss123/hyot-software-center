---
import Base from '../../layouts/Base.astro'
import AppIcon from '../../components/AppIcon.astro'
import ToolIndex from '../../components/ToolIndex.astro'
import { t, localeStaticPaths, type Locale } from '../../lib/i18n'
import { getTools } from '../../lib/tools'
import { absolute, publisher } from '../../lib/seo'

export const getStaticPaths = localeStaticPaths

const locale = Astro.params.locale as Locale
const tools = await getTools(locale)
// 검색엔진용: 사이트 정보와 도구 목록
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'HyoT',
    alternateName: 'hyot.dev',
    url: absolute(Astro.url.pathname),
    inLanguage: locale,
    description: t(locale, 'site.description'),
    publisher,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: t(locale, 'home.catalog'),
    itemListElement: tools.map((tool, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: tool.name,
      url: absolute(tool.href),
    })),
  },
]
---

<Base locale={locale} title={t(locale, 'seo.home')} jsonLd={jsonLd}>
  <div class="wrap landing">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">
          {t(locale, 'home.titleFirst')}
          <span>{t(locale, 'home.titleSecond')}</span>
        </h1>
        <p>{t(locale, 'home.description')}</p>
        <a class="btn btn-primary" href="#utilities">
          {t(locale, 'home.browse')} <span aria-hidden="true">↓</span>
        </a>
      </div>
      {/* 도구 전체를 한눈에 보여 주는 바로 가기. 웹 버전이 있으면 웹 도구를 바로 연다. */}
      <nav class="hero-art" aria-label={t(locale, 'home.launcher')}>
        <ul class="launcher" role="list">
          {
            tools.map((tool) => (
              <li>
                <a class="tile" href={tool.launch}>
                  <AppIcon software={tool.software} src={tool.icon} size={56} loading="eager" />
                  <span class="tile-name">{tool.name}</span>
                  <span class:list={['tile-meta', { web: tool.web }]}>
                    {t(locale, tool.web ? 'home.tileUse' : 'home.tileDownload')}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </section>

    <section class="catalog" id="utilities" aria-labelledby="catalog-title">
      <h2 id="catalog-title">{t(locale, 'home.catalog')}</h2>
      <ToolIndex locale={locale} tools={tools} />
    </section>
  </div>
</Base>

<style>
  .landing {
    padding-top: clamp(1.15rem, 3vw, 2.4rem);
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(2rem, 4.75vw, 4.25rem);
  }
  h1 {
    font-size: clamp(2.65rem, 5.35vw, 5.1rem);
    line-height: 1.02;
    letter-spacing: -0.075em;
    text-wrap: initial;
  }
  h1:lang(en) {
    font-size: clamp(2.35rem, 4.6vw, 4.2rem);
  }
  h1 span {
    display: block;
    color: var(--link);
  }
  .hero-copy p {
    max-width: 27em;
    margin-block: clamp(1rem, 2.25vw, 1.8rem) clamp(1.35rem, 2.5vw, 2rem);
    color: var(--ink-soft);
    font-size: clamp(0.95rem, 1.5vw, 1.14rem);
    line-height: 1.55;
  }
  .hero-art {
    display: grid;
    place-items: center;
    padding: clamp(1.25rem, 3.5vw, 2.5rem);
    background: var(--surface-toned);
  }
  .launcher {
    --gap: clamp(0.55rem, 1.4vw, 0.85rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
    width: 100%;
    max-width: 31rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* 한 줄에 세 개씩, 남는 줄은 가운데 정렬 */
  .launcher li {
    flex: 0 0 calc((100% - 2 * var(--gap)) / 3);
  }
  .tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    height: 100%;
    padding: clamp(0.85rem, 2vw, 1.15rem) 0.5rem clamp(0.75rem, 1.8vw, 1rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-align: center;
    text-decoration: none;
    transition: border-color 160ms ease, transform 160ms ease;
  }
  .tile:hover,
  .tile:focus-visible {
    border-color: var(--link);
    transform: translateY(-2px);
  }
  .tile :global(.app-icon) {
    margin-bottom: 0.15rem;
  }
  .tile-name {
    font-size: clamp(0.875rem, 1.4vw, 0.98rem);
    font-weight: 760;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }
  .tile-meta {
    color: var(--ink-soft);
    font-size: var(--t-xs);
    font-weight: 650;
  }
  .tile-meta.web {
    color: var(--link);
  }
  .catalog {
    margin-top: clamp(2.5rem, 5vw, 4.3rem);
    scroll-margin-top: 1.5rem;
  }
  h2 {
    margin-bottom: 1.12rem;
    font-size: var(--t-lg);
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-copy {
      padding: clamp(1.4rem, 5.5vw, 2.5rem);
    }
  }
  @media (max-width: 420px) {
    .tile :global(.app-icon) {
      --s: 44px !important;
    }
  }
</style>
