---
import { Image } from 'astro:assets'
import Base from '../../layouts/Base.astro'
import SoftwareIndex from '../../components/SoftwareIndex.astro'
import schoolScreen from '../../content/software/today-meal/cover.webp'
import { t, path, categories, localeStaticPaths, type Locale } from '../../lib/i18n'
import { getSoftware } from '../../lib/software'

export const getStaticPaths = localeStaticPaths

const locale = Astro.params.locale as Locale
const items = await getSoftware()
const counts = new Map<keyof typeof categories, number>()
for (const { data: { category } } of items) {
  counts.set(category, (counts.get(category) ?? 0) + 1)
}
const availableCategories = [...counts].map(([key, count]) => ({ key, count, label: categories[key][locale] }))
---

<Base locale={locale}>
  <div class="wrap landing">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">
          {t(locale, 'home.titleFirst')}
          <span>{t(locale, 'home.titleSecond')}</span>
        </h1>
        <p>{t(locale, 'home.description')}</p>
        <a class="btn btn-primary" href="#utilities">
          {t(locale, 'home.browse')} <span aria-hidden="true">↓</span>
        </a>
      </div>
      <a class="hero-art" href={path(locale, 'today-school')} aria-label={t(locale, 'home.schoolOpen')}>
        <Image
          src={schoolScreen}
          alt={t(locale, 'home.schoolPreview')}
          widths={[480, 760, 1200]}
          sizes="(max-width: 760px) calc(100vw - 2rem), 580px"
          format="webp"
          quality={83}
          loading="eager"
          fetchpriority="high"
        />
        <span>{t(locale, 'home.schoolOpen')} <span aria-hidden="true">↗</span></span>
      </a>
    </section>

    <section class="catalog" id="utilities" aria-labelledby="catalog-title">
      <div class="catalog-head">
        <h2 id="catalog-title">{t(locale, 'home.catalog')}</h2>
        {
          availableCategories.length > 1 && (
            <div class="filters" data-filters role="group" aria-label={t(locale, 'software.category')} hidden>
              <button type="button" data-filter="all" aria-pressed="true">
                {t(locale, 'software.all')} <span class="num">{items.length}</span>
              </button>
              {availableCategories.map(({ key, count, label }) => (
                <button type="button" data-filter={key} aria-pressed="false">
                  {label} <span class="num">{count}</span>
                </button>
              ))}
            </div>
          )
        }
      </div>
      <SoftwareIndex locale={locale} items={items} />
    </section>

    <section class="clock-feature" aria-labelledby="clock-title">
      <span class="clock-mark" aria-hidden="true"></span>
      <div class="clock-copy">
        <h2 id="clock-title">{t(locale, 'nav.clock')}</h2>
        <p>{t(locale, 'clock.description')}</p>
      </div>
      <a class="btn" href={path(locale, 'clock')} aria-describedby="clock-title">
        {t(locale, 'home.live')} <span aria-hidden="true">↗</span>
      </a>
    </section>
  </div>
</Base>

<script>
  const filters = document.querySelector<HTMLElement>('[data-filters]')
  if (filters) {
    const buttons = filters.querySelectorAll<HTMLButtonElement>('button')
    const items = document.querySelectorAll<HTMLElement>('#utilities [data-category]')
    filters.hidden = false
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter
        buttons.forEach((option) => option.setAttribute('aria-pressed', String(option === button)))
        items.forEach((item) => {
          item.hidden = filter !== 'all' && item.dataset.category !== filter
        })
      })
    })
  }
</script>

<style>
  .landing {
    padding-top: clamp(1.15rem, 3vw, 2.4rem);
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    border: 1px solid var(--line);
    border-radius: clamp(1.15rem, 3vw, 1.9rem);
    background: var(--surface);
    overflow: hidden;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(2rem, 4.75vw, 4.25rem);
  }
  h1 {
    font-size: clamp(2.65rem, 5.35vw, 5.1rem);
    line-height: 1.02;
    letter-spacing: -0.075em;
    text-wrap: initial;
  }
  h1:lang(en) {
    font-size: clamp(2.35rem, 4.6vw, 4.2rem);
  }
  h1 span {
    display: block;
    color: var(--link);
  }
  .hero-copy p {
    max-width: 27em;
    margin-block: clamp(1rem, 2.25vw, 1.8rem) clamp(1.35rem, 2.5vw, 2rem);
    color: var(--ink-soft);
    font-size: clamp(0.95rem, 1.5vw, 1.14rem);
    line-height: 1.55;
  }
  .hero-art {
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: start;
    align-items: center;
    gap: .85rem;
    padding: clamp(1rem, 3vw, 2rem);
    background: var(--surface-toned);
    color: var(--ink);
    text-decoration: none;
  }
  .hero-art img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: .75rem;
  }
  .hero-art > span {
    color: var(--link);
    font-size: var(--t-sm);
    font-weight: 730;
  }
  .hero-art:hover > span { text-decoration: underline; }
  .hero-art:focus-visible { outline-offset: -4px; }
  .catalog {
    margin-top: clamp(2.5rem, 5vw, 4.3rem);
    scroll-margin-top: 1.5rem;
  }
  .catalog-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.12rem;
  }
  h2 {
    font-size: var(--t-lg);
  }
  .filters:not([hidden]) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.38rem;
  }
  .filters button {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 2rem;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    font-size: var(--t-sm);
    font-weight: 690;
  }
  .filters button:hover {
    background: var(--surface-toned);
  }
  .filters button[aria-pressed='true'] {
    border-color: var(--action);
    background: var(--action);
    color: var(--on-action);
  }
  .filters .num {
    font-size: 0.75rem;
    opacity: 0.83;
  }
  .clock-feature {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.9rem, 3vw, 1.5rem);
    margin-top: clamp(1.2rem, 3.8vw, 2.7rem);
    padding: clamp(1.1rem, 3.5vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-toned);
  }
  .clock-copy h2 {
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
  }
  .clock-copy p {
    margin-top: 0.3rem;
    color: var(--ink-soft);
  }
  .clock-mark {
    display: grid;
    place-items: center;
    position: relative;
    width: clamp(3rem, 7vw, 4.4rem);
    aspect-ratio: 1;
    border-radius: 1rem;
    background: #19382a;
    color: #c9edb8;
  }
  .clock-mark::before {
    content: '';
    width: 52%;
    aspect-ratio: 1;
    border: 2px solid currentColor;
    border-radius: 50%;
  }
  .clock-mark::after {
    content: '';
    position: absolute;
    top: 34%;
    left: calc(50% - 1px);
    width: 15%;
    height: 17%;
    border: solid currentColor;
    border-width: 0 0 2px 2px;
    border-bottom-left-radius: 2px;
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero-copy {
      padding: clamp(1.4rem, 5.5vw, 2.5rem);
    }
  }
  @media (max-width: 560px) {
    .clock-feature {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .clock-feature .btn {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }
</style>
