---
import { render } from 'astro:content'
import Base from '../../../../layouts/Base.astro'
import AppIcon from '../../../../components/AppIcon.astro'
import SoftwareCover from '../../../../components/SoftwareCover.astro'
import SoftwareScreenshot from '../../../../components/SoftwareScreenshot.astro'
import {
  t,
  path,
  locales,
  formatDate,
  formatSize,
  categories,
  platformNames,
  assetNames,
  type Locale,
} from '../../../../lib/i18n'
import {
  getSoftware,
  displayName,
  tagline,
  latestRelease,
  latestAny,
  sortedReleases,
  pageSlug,
  type Software,
} from '../../../../lib/software'
import { ogImageFor, categoryType, absolute, free, publisher } from '../../../../lib/seo'

export async function getStaticPaths() {
  const items = await getSoftware()
  return locales.flatMap((locale) =>
    items.map((software) => ({ params: { locale, slug: pageSlug(software) }, props: { software } })),
  )
}

const locale = Astro.params.locale as Locale
const { software } = Astro.props as { software: Software }
const data = software.data
const name = displayName(software, locale)
const description = tagline(software, locale)
const stable = latestRelease(software)
const beta = latestRelease(software, 'beta')
const current = stable ?? latestAny(software)
const assets = current?.downloads ?? []
const primary = assets.find((asset) => asset.type === 'installer') ?? assets[0]
const others = assets.filter((asset) => asset !== primary)
const platforms = data.platforms.map((platform) => platformNames[platform])
const requirements = locale === 'en' ? data.requirements_en ?? data.requirements : data.requirements
const korean = locale === 'ko'
// 업데이트 내역: 최신 버전부터, 영어 페이지는 영어 노트가 있으면 그것을 쓴다.
const history = sortedReleases(software)
  .map((release) => ({ ...release, lines: (!korean && release.notes_en?.length ? release.notes_en : release.notes) }))
  .filter((release) => release.lines.length > 0)
const webPage = data.web ? path(locale, data.web) : undefined
const platform = platforms[0]
// 다운로드 버튼 문구는 "<플랫폼>용 (ZIP) 다운로드" 한 가지 형식으로 맞춘다.
const zip = primary?.type === 'portable'
const primaryLabel = platform
  ? (korean ? `${platform}용 ${zip ? 'ZIP ' : ''}다운로드` : `Download ${zip ? 'ZIP ' : ''}for ${platform}`)
  : t(locale, 'software.download')
const assetLabel = (asset: (typeof assets)[number]) =>
  asset.type === 'apk'
    ? (korean ? 'Android용 다운로드' : 'Download for Android')
    : (korean ? asset.label : asset.label_en) ?? assetNames[asset.type][locale]
const downloadInfo = [current && `v${current.version}`, primary?.arch, formatSize(primary?.size)].filter(Boolean)
const shotTitles = (!korean && data.screenshot_titles_en) || data.screenshot_titles
// 표지가 없으면 첫 스크린샷을 보여 주고, 스크린샷은 잘리지 않게 액자 모양으로 넣는다.
const heroImage = data.cover ?? data.screenshots[0]
const heroFramed = !data.cover || data.cover_fit === 'frame'
// 스크린샷은 화면 내용을 전하므로 설명을 붙이고, 삽화 표지는 장식이라 비워 둔다.
const heroAlt = heroFramed
  ? `${name} ${(!data.cover && shotTitles[0]) || (korean ? '화면' : 'screen')}`
  : ''
const { Content } = await render(software)
const enParagraphs = !korean && data.description_en ? data.description_en.split(/\n{2,}/) : null
const fileName = (asset: (typeof assets)[number]) => asset.filename ?? asset.url.split('/').pop()

// 검색엔진용 정보
const pageUrl = new URL(Astro.url.pathname, Astro.site).href
const ogImage = await ogImageFor(heroImage)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name,
  ...(data.name_ko && data.name_ko !== data.name ? { alternateName: korean ? data.name : data.name_ko } : {}),
  description,
  url: pageUrl,
  applicationCategory: categoryType(data.category),
  operatingSystem: platforms.join(', '),
  ...(current ? { softwareVersion: current.version, dateModified: current.date.toISOString().slice(0, 10) } : {}),
  ...(primary ? { downloadUrl: absolute(primary.url) } : {}),
  ...(formatSize(primary?.size) ? { fileSize: formatSize(primary?.size) } : {}),
  ...(ogImage ? { image: ogImage } : {}),
  inLanguage: 'ko',
  isAccessibleForFree: true,
  offers: free,
  publisher,
}
---

<Base locale={locale} title={`${name} – ${description}`} description={description} image={ogImage} jsonLd={jsonLd}>
  <div class="wrap detail">
    <a class="back" href={`${path(locale)}#utilities`}>
      <span aria-hidden="true">←</span> {t(locale, 'software.back')}
    </a>

    <header class:list={['hero', { 'has-cover': heroImage }]}>
      <div class="hero-copy">
        <div class="app-heading">
          <AppIcon software={software} size={58} loading="eager" />
          <p>{categories[data.category][locale]}</p>
        </div>
        <h1>{name}</h1>
        <p class="description">{description}</p>

        <div class="actions">
          {webPage && (
            <a class="btn btn-primary" href={webPage}>
              {t(locale, 'software.useWeb')} <span aria-hidden="true">→</span>
            </a>
          )}
          {
            primary ? (
              <a class:list={['btn', { 'btn-primary': !webPage }]} href={primary.url} download={fileName(primary)}>
                {primaryLabel} <span aria-hidden="true">↓</span>
              </a>
            ) : <p class="muted">{t(locale, 'software.noDownload')}</p>
          }
          {
            others.map((asset) => (
              <a class="btn" href={asset.url} download={fileName(asset)}>
                {assetLabel(asset)}
                {formatSize(asset.size) && <small class="num">{formatSize(asset.size)}</small>}
                <span aria-hidden="true">↓</span>
              </a>
            ))
          }
        </div>
        {primary && downloadInfo.length > 0 && <p class="download-info num">{downloadInfo.join(' · ')}</p>}
        {
          beta && stable && beta.date > stable.date && beta.downloads[0] && (
            <a class="beta" href={beta.downloads[0].url}>{t(locale, 'software.beta')} v{beta.version}</a>
          )
        }
      </div>
      {heroImage && <SoftwareCover software={software} image={heroImage} framed={heroFramed} alt={heroAlt} featured />}
    </header>

    {
      data.screenshots.length > 0 && (
        <section class="screenshots" aria-labelledby="screenshots-title">
          <h2 id="screenshots-title">{t(locale, 'software.screenshots')}</h2>
          <div class="gallery">
            {data.screenshots.map((image, i) => (
              <SoftwareScreenshot
                image={image}
                title={shotTitles[i] ?? `${name} · ${t(locale, 'software.screenshots')} ${i + 1}`}
                fullSizeLabel={t(locale, 'software.openScreenshot')}
              />
            ))}
          </div>
        </section>
      )
    }

    <div class="detail-body">
      <div class="main-col">
        <section class="overview" aria-labelledby="overview-title">
          <h2 id="overview-title">{t(locale, 'software.overview')}</h2>
          <div class="prose">
            {enParagraphs ? enParagraphs.map((paragraph) => <p>{paragraph}</p>) : <Content />}
          </div>
        </section>

        {
          history.length > 0 && (
            <section class="history" aria-labelledby="history-title">
              <h2 id="history-title">{t(locale, 'software.history')}</h2>
              <ol class="releases" role="list">
                {history.map((release, i) => (
                  <li>
                    <details open={i === 0}>
                      <summary>
                        <span class="version num">v{release.version}</span>
                        {release.channel === 'beta' && <span class="badge">{t(locale, 'software.beta')}</span>}
                        <time class="num" datetime={release.date.toISOString().slice(0, 10)}>
                          {formatDate(release.date, locale)}
                        </time>
                      </summary>
                      <ul>
                        {release.lines.map((line) => <li>{line}</li>)}
                      </ul>
                    </details>
                  </li>
                ))}
              </ol>
            </section>
          )
        }
      </div>

      <aside class="info" aria-labelledby="info-title">
        <h2 id="info-title">{t(locale, 'software.info')}</h2>
        <dl>
          {
            current && (
              <>
                <div>
                  <dt>{t(locale, 'software.version')}</dt>
                  <dd class="num">v{current.version}</dd>
                </div>
                <div>
                  <dt>{t(locale, 'software.updated')}</dt>
                  <dd class="num">
                    <time datetime={current.date.toISOString().slice(0, 10)}>{formatDate(current.date, locale)}</time>
                  </dd>
                </div>
              </>
            )
          }
          <div>
            <dt>{t(locale, 'software.platform')}</dt>
            <dd>{platforms.join(' · ')}</dd>
          </div>
          {
            requirements.length > 0 && (
              <div>
                <dt>{t(locale, 'software.requirements')}</dt>
                <dd>{requirements.join(' · ')}</dd>
              </div>
            )
          }
          {
            data.repo && (
              <div>
                <dt>{t(locale, 'software.source')}</dt>
                <dd><a href={data.repo}>GitHub ↗</a></dd>
              </div>
            )
          }
          {
            primary?.sha256 && (
              <div class="hash">
                <dt>{t(locale, 'software.sha')}</dt>
                <dd><code>{primary.sha256}</code></dd>
              </div>
            )
          }
        </dl>
      </aside>
    </div>
  </div>
</Base>

<style>
  .detail {
    padding-top: clamp(1.2rem, 4vw, 2.4rem);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.5rem;
    margin-bottom: 0.75rem;
    border-radius: 0.35rem;
    color: var(--ink-soft);
    font-size: var(--t-sm);
    font-weight: 690;
    text-decoration: none;
  }
  .back:hover {
    color: var(--link);
    text-decoration: underline;
  }
  .hero {
    display: grid;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
  }
  .has-cover {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.13fr);
  }
  .has-cover :global(.cover) {
    min-height: clamp(20rem, 34vw, 26rem);
    aspect-ratio: auto;
  }
  .hero-copy {
    align-self: center;
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }
  .app-heading {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: clamp(0.95rem, 2vw, 1.35rem);
    color: var(--ink-soft);
    font-size: var(--t-sm);
    font-weight: 700;
  }
  h1 {
    font-size: clamp(2.15rem, 5.1vw, 4.35rem);
    letter-spacing: -0.065em;
  }
  .description {
    max-width: 31em;
    margin-top: 0.7rem;
    color: var(--ink-soft);
    font-size: var(--t-md);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-top: clamp(1.15rem, 2.5vw, 1.65rem);
  }
  .download-info, .beta {
    margin-top: 0.55rem;
    font-size: var(--t-sm);
  }
  .download-info {
    color: var(--ink-soft);
  }
  .beta {
    display: inline-block;
  }
  .screenshots, .detail-body {
    margin-top: clamp(2.1rem, 5vw, 3.8rem);
  }
  .screenshots h2, .overview > h2 {
    margin-bottom: 1rem;
    font-size: var(--t-lg);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    align-items: start;
    gap: 1rem;
  }
  .detail-body {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(16rem, 1fr);
    gap: clamp(1.1rem, 3.6vw, 3rem);
    align-items: start;
  }
  .overview {
    padding-block: 0.8rem;
  }
  .history {
    max-width: 66ch;
    margin-top: clamp(1.8rem, 4vw, 2.6rem);
  }
  .history h2 {
    margin-bottom: 0.8rem;
    font-size: var(--t-md);
  }
  .releases {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .releases > li {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
    min-height: 2.75rem;
    padding-block: 0.5rem;
    cursor: pointer;
  }
  .version {
    font-weight: 760;
  }
  summary time {
    color: var(--ink-soft);
    font-size: var(--t-sm);
  }
  .badge {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--surface-toned);
    color: var(--ink-soft);
    font-size: var(--t-xs);
    font-weight: 690;
  }
  details ul {
    margin: 0 0 0.9rem;
    padding-inline-start: 1.25em;
    color: var(--ink-soft);
  }
  details li + li {
    margin-top: 0.35em;
  }
  .prose {
    max-width: 66ch;
  }
  .info {
    padding: clamp(1rem, 2.75vw, 1.65rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .info h2 {
    margin-bottom: 0.65rem;
    font-size: var(--t-md);
  }
  dl, dd {
    margin: 0;
  }
  dl > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.45rem 0.85rem;
    padding-top: 0.65rem;
    margin-top: 0.65rem;
    border-top: 1px solid var(--line);
  }
  dt {
    flex: none;
    color: var(--ink-soft);
    font-size: var(--t-sm);
  }
  dd {
    text-align: end;
    font-weight: 640;
  }
  .hash {
    flex-direction: column;
  }
  .hash dd {
    text-align: start;
    font-size: 0.76rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  @media (max-width: 760px) {
    .hero, .detail-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .has-cover :global(.cover) {
      min-height: 0;
      aspect-ratio: 1.75;
    }
    .has-cover :global(.cover.framed) {
      aspect-ratio: auto;
    }
  }
  /* 휴대폰에서는 다운로드 버튼을 같은 폭으로 쌓는다. */
  @media (max-width: 520px) {
    .actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
