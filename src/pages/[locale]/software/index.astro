---
import { path, localeStaticPaths, type Locale } from '../../../lib/i18n'

export const getStaticPaths = localeStaticPaths
const to = path(Astro.params.locale as Locale)
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={new URL(to, Astro.site)} />
    <meta name="robots" content="noindex" />
  </head>
  <body><a href={to}>hyot.dev</a></body>
</html>
