---
import Base from '../../layouts/Base.astro'
import ToolHeading from '../../components/ToolHeading.astro'
import { localeStaticPaths, t, type Locale } from '../../lib/i18n'

export const getStaticPaths = localeStaticPaths

const locale = Astro.params.locale as Locale
const title = t(locale, 'nav.clock')
---

<Base locale={locale} title={title} description={t(locale, 'clock.description')} ads={false}>
  <section class="wrap clock-page" aria-labelledby="clock-title" data-clock>
    <ToolHeading id="clock-title" title={title} description={t(locale, 'clock.description')} />
    <div class="clock-panel" data-clock-panel>
      <div class="clock-toolbar" data-controls hidden>
        <div class="clock-meta">
          <p class="clock-zone">
            <span class="sr-only">{t(locale, 'clock.zone')}</span>
            <span aria-hidden="true">KST · UTC+9</span>
          </p>
          <p
            class="clock-source"
            role="status"
            data-clock-source
            data-synced={t(locale, 'clock.synced')}
            data-device={t(locale, 'clock.deviceTime')}
            data-last-sync={t(locale, 'clock.lastSync')}
          >{t(locale, 'clock.syncing')}</p>
        </div>
        <div class="clock-settings">
          <div class="clock-size" role="group" aria-label={t(locale, 'clock.size')}>
            <button class="clock-step" type="button" aria-label={t(locale, 'clock.smaller')} data-smaller>−</button>
            <output class="num" data-size>100%</output>
            <button class="clock-step" type="button" aria-label={t(locale, 'clock.larger')} data-larger>+</button>
          </div>
          <button class="btn btn-primary clock-control" type="button" data-fullscreen-enter hidden>
            {t(locale, 'clock.fullscreen')}
          </button>
        </div>
      </div>
      <div class="clock-stage" tabindex="-1" data-clock-stage>
        <time class="clock-time" hidden></time>
        <noscript>{t(locale, 'clock.requiresJs')}</noscript>
        <button
          class="btn clock-exit"
          type="button"
          aria-label={t(locale, 'clock.exitFullscreen')}
          title={t(locale, 'clock.exitFullscreen')}
          data-fullscreen-exit
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor"
            stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 3v6H3m18 0h-6V3M3 15h6v6m6 0v-6h6" />
          </svg>
        </button>
      </div>
    </div>
    <dialog class="clock-dialog" aria-label={title} data-clock-dialog></dialog>
  </section>
</Base>

<script>
  import { getClockOffset } from '../../lib/clock-time'

  const clock = document.querySelector<HTMLElement>('[data-clock]')

  if (clock) {
    const panel = clock.querySelector<HTMLElement>('[data-clock-panel]')!
    const stage = clock.querySelector<HTMLElement>('[data-clock-stage]')!
    const dialog = clock.querySelector<HTMLDialogElement>('[data-clock-dialog]')!
    const face = stage.querySelector<HTMLTimeElement>('time')!
    const exitButton = stage.querySelector<HTMLButtonElement>('[data-fullscreen-exit]')!
    const controls = clock.querySelector<HTMLElement>('[data-controls]')!
    const smaller = controls.querySelector<HTMLButtonElement>('[data-smaller]')!
    const larger = controls.querySelector<HTMLButtonElement>('[data-larger]')!
    const size = controls.querySelector<HTMLOutputElement>('[data-size]')!
    const fullscreenButton = controls.querySelector<HTMLButtonElement>('[data-fullscreen-enter]')!
    const source = controls.querySelector<HTMLElement>('[data-clock-source]')!

    const formatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Seoul',
      hourCycle: 'h23',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
    })
    let tickTimer: number
    let offset: number | undefined
    let syncing = false
    let nextSync = 0
    let systemOffset = Date.now() - performance.now()

    async function synchronize() {
      syncing = true
      const result = await getClockOffset()
      syncing = false
      nextSync = performance.now() + (result === undefined ? 120_000 : 900_000)

      if (result !== undefined) {
        offset = result
        source.textContent = source.dataset.synced ?? ''
        updateTime()
      } else {
        source.textContent = (offset === undefined ? source.dataset.device : source.dataset.lastSync) ?? ''
      }
    }

    function updateTime() {
      window.clearTimeout(tickTimer)
      const elapsed = performance.now()
      const systemTime = Date.now()
      const newSystemOffset = systemTime - elapsed
      // Some browsers pause the monotonic clock while the computer sleeps.
      if (Math.abs(newSystemOffset - systemOffset) >= 5000) nextSync = 0
      systemOffset = newSystemOffset

      const time = offset === undefined ? systemTime : offset + elapsed
      face.textContent = formatter.format(time)
      face.dateTime = new Date(time).toISOString()
      if (!document.hidden) {
        tickTimer = window.setTimeout(updateTime, 1000 - (time % 1000))
        if (!syncing && elapsed >= nextSync) void synchronize()
      }
    }

    updateTime()
    face.hidden = false
    document.addEventListener('visibilitychange', updateTime)
    window.addEventListener('pageshow', updateTime)
    window.addEventListener('online', () => {
      nextSync = 0
      updateTime()
    })

    const scaleKey = 'clock-scale'
    const minScale = 50
    const maxScale = 120
    const step = 10
    let scale = 100

    try {
      const saved = Number(localStorage.getItem(scaleKey))
      if (saved >= minScale && saved <= maxScale && saved % step === 0) scale = saved
    } catch {}

    function showScale() {
      face.style.setProperty('--clock-scale', String(scale / 100))
      size.value = `${scale}%`
      smaller.disabled = scale === minScale
      larger.disabled = scale === maxScale
    }

    function changeScale(amount: number) {
      scale = Math.min(maxScale, Math.max(minScale, scale + amount))
      showScale()
      try {
        localStorage.setItem(scaleKey, String(scale))
      } catch {}
    }

    showScale()
    smaller.addEventListener('click', () => changeScale(-step))
    larger.addEventListener('click', () => changeScale(step))

    controls.hidden = false
    const canOpenDialog = typeof dialog.showModal === 'function'
    fullscreenButton.hidden = !document.fullscreenEnabled && !canOpenDialog
    let opening = false
    let exitTimer: number

    function hideExit() {
      window.clearTimeout(exitTimer)
      stage.removeAttribute('data-exit-visible')
    }

    function revealExit() {
      if (!stage.hasAttribute('data-expanded')) return
      stage.setAttribute('data-exit-visible', '')
      window.clearTimeout(exitTimer)
      exitTimer = window.setTimeout(hideExit, 3000)
    }

    function setExpanded(expanded: boolean) {
      stage.toggleAttribute('data-expanded', expanded)
      hideExit()
      if (expanded) stage.focus({ preventScroll: true })
      else fullscreenButton.focus({ preventScroll: true })
    }

    fullscreenButton.addEventListener('click', async () => {
      if (opening) return
      opening = true
      try {
        if (document.fullscreenEnabled) {
          try {
            await stage.requestFullscreen()
            return
          } catch {
            // Fullscreen can be blocked by the browser or by an embedding page.
          }
        }
        if (canOpenDialog && !dialog.open) {
          dialog.append(stage)
          dialog.showModal()
          setExpanded(true)
        }
      } finally {
        opening = false
      }
    })

    stage.addEventListener('fullscreenchange', () => setExpanded(document.fullscreenElement === stage))
    dialog.addEventListener('close', () => {
      panel.append(stage)
      setExpanded(false)
    })
    exitButton.addEventListener('click', () => {
      if (dialog.open) dialog.close()
      else if (document.fullscreenElement === stage) void document.exitFullscreen()
    })
    stage.addEventListener('pointermove', revealExit)
    stage.addEventListener('pointerdown', revealExit)
    stage.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab' || !stage.hasAttribute('data-expanded')) return
      event.preventDefault()
      exitButton.focus()
    })
  }
</script>

<style>
  .clock-page {
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.75rem, 7vw, 5rem);
  }
  .clock-panel {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .clock-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding: 0.85rem clamp(0.75rem, 2.5vw, 1.5rem);
    border-bottom: 1px solid var(--line);
  }
  .clock-page [hidden] {
    display: none;
  }
  .clock-meta {
    display: grid;
    gap: 0.15rem;
    line-height: 1.35;
  }
  .clock-zone {
    color: var(--link);
    font-size: var(--t-sm);
    font-weight: 750;
    letter-spacing: 0.08em;
  }
  .clock-source {
    color: var(--ink-soft);
    font-size: var(--t-xs);
  }
  .clock-settings {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--t-sm);
  }
  .clock-size {
    display: flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: var(--surface-toned);
  }
  .clock-size output {
    min-width: 4.5ch;
    font-weight: 690;
    text-align: center;
  }
  .clock-step {
    width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 0.65rem;
    background: transparent;
    color: var(--ink);
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
  }
  .clock-step:hover:not(:disabled) {
    background: var(--surface);
  }
  .clock-step:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .clock-control {
    min-height: calc(2.75rem + 2px);
    padding: 0.4rem 0.8rem;
    white-space: nowrap;
    cursor: pointer;
  }
  .clock-stage {
    position: relative;
    display: grid;
    place-items: center;
    container-type: inline-size;
    min-height: clamp(14rem, 43dvh, 34rem);
    background: var(--surface);
    color: var(--ink);
  }
  .clock-stage:focus {
    outline: none;
  }
  .clock-time {
    font-size: min(calc(17cqi * var(--clock-scale, 1)), 35dvh);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.045em;
    line-height: 1;
    white-space: nowrap;
  }
  .clock-stage:is(:fullscreen, [data-expanded]) {
    width: 100%;
    height: 100%;
    min-height: 0;
    background: var(--paper);
  }
  .clock-stage:is(:fullscreen, [data-expanded]) .clock-time {
    font-size: min(calc(17cqi * var(--clock-scale, 1)), 68dvh);
  }
  .clock-dialog {
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: var(--paper);
  }
  :global(html:has(.clock-dialog[open])) {
    overflow: hidden;
  }
  .clock-exit {
    position: absolute;
    inset-block-start: max(0.85rem, env(safe-area-inset-top));
    inset-inline-end: max(0.85rem, env(safe-area-inset-right));
    display: none;
    width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    opacity: 0;
    pointer-events: none;
    cursor: pointer;
  }
  .clock-stage[data-expanded] .clock-exit {
    display: inline-flex;
  }
  .clock-stage[data-exit-visible] .clock-exit,
  .clock-exit:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }
  @media (hover: hover) and (pointer: fine) {
    .clock-stage[data-expanded]:not([data-exit-visible], :has(.clock-exit:focus-visible)) {
      cursor: none;
    }
  }
</style>
