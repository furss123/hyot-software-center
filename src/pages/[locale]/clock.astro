---
import Brand from '../../components/Brand.astro'
import Base from '../../layouts/Base.astro'
import { localeStaticPaths, path, t, type Locale } from '../../lib/i18n'

export const getStaticPaths = localeStaticPaths

const locale = Astro.params.locale as Locale
const title = t(locale, 'nav.clock')
---

<Base locale={locale} title={title} description={t(locale, 'clock.description')} presentation>
  <div class="clock" data-clock>
    <h1 class="sr-only">{title}</h1>
    <time class="clock-time" hidden></time>
    <noscript>{t(locale, 'clock.requiresJs')}</noscript>

    <header class="wrap clock-controls" data-controls hidden>
      <a class="clock-home" href={path(locale)}><Brand /></a>
      <div class="clock-meta">
        <p class="clock-zone">
          <span class="sr-only">{t(locale, 'clock.zone')}</span>
          <span aria-hidden="true">KST · UTC+9</span>
        </p>
        <p
          class="clock-source"
          role="status"
          data-clock-source
          data-synced={t(locale, 'clock.synced')}
          data-device={t(locale, 'clock.deviceTime')}
          data-last-sync={t(locale, 'clock.lastSync')}
        >{t(locale, 'clock.syncing')}</p>
      </div>
      <div class="clock-settings">
        <div class="clock-size" role="group" aria-label={t(locale, 'clock.size')}>
          <button class="clock-step" type="button" aria-label={t(locale, 'clock.smaller')} data-smaller>−</button>
          <output class="num" data-size>100%</output>
          <button class="clock-step" type="button" aria-label={t(locale, 'clock.larger')} data-larger>+</button>
        </div>
        <button
          class="btn clock-control"
          type="button"
          data-theme-toggle
          data-light={t(locale, 'clock.light')}
          data-dark={t(locale, 'clock.dark')}
        >{t(locale, 'clock.dark')}</button>
        <button
          class="btn btn-primary clock-control"
          type="button"
          data-fullscreen-toggle
          data-enter={t(locale, 'clock.fullscreen')}
          data-exit={t(locale, 'clock.exitFullscreen')}
          hidden
        >{t(locale, 'clock.fullscreen')}</button>
      </div>
    </header>
  </div>
</Base>

<script>
  import { getClockOffset } from '../../lib/clock-time'

  const clock = document.querySelector<HTMLElement>('[data-clock]')

  if (clock) {
    const face = clock.querySelector<HTMLTimeElement>('time')!
    const controls = clock.querySelector<HTMLElement>('[data-controls]')!
    const smaller = controls.querySelector<HTMLButtonElement>('[data-smaller]')!
    const larger = controls.querySelector<HTMLButtonElement>('[data-larger]')!
    const size = controls.querySelector<HTMLOutputElement>('[data-size]')!
    const themeButton = controls.querySelector<HTMLButtonElement>('[data-theme-toggle]')!
    const fullscreenButton = controls.querySelector<HTMLButtonElement>('[data-fullscreen-toggle]')!
    const source = controls.querySelector<HTMLElement>('[data-clock-source]')!

    const formatter = new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Asia/Seoul',
      hourCycle: 'h23',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
    })
    let tickTimer: number
    let offset: number | undefined
    let syncing = false
    let nextSync = 0
    let systemOffset = Date.now() - performance.now()

    async function synchronize() {
      syncing = true
      const result = await getClockOffset()
      syncing = false
      nextSync = performance.now() + (result === undefined ? 120_000 : 900_000)

      if (result !== undefined) {
        offset = result
        source.textContent = source.dataset.synced ?? ''
        updateTime()
      } else {
        source.textContent = (offset === undefined ? source.dataset.device : source.dataset.lastSync) ?? ''
      }
    }

    function updateTime() {
      window.clearTimeout(tickTimer)
      const elapsed = performance.now()
      const systemTime = Date.now()
      const newSystemOffset = systemTime - elapsed
      // Some browsers pause the monotonic clock while the computer sleeps.
      if (Math.abs(newSystemOffset - systemOffset) >= 5000) nextSync = 0
      systemOffset = newSystemOffset

      const time = offset === undefined ? systemTime : offset + elapsed
      const value = formatter.format(time)
      face.textContent = value
      face.dateTime = value
      if (!document.hidden) {
        tickTimer = window.setTimeout(updateTime, 1000 - (time % 1000))
        if (!syncing && elapsed >= nextSync) void synchronize()
      }
    }

    updateTime()
    face.hidden = false
    document.addEventListener('visibilitychange', updateTime)
    window.addEventListener('pageshow', updateTime)
    window.addEventListener('online', () => {
      nextSync = 0
      updateTime()
    })

    const scaleKey = 'clock-scale'
    const minScale = 50
    const maxScale = 120
    const step = 10
    let scale = 100

    try {
      const saved = Number(localStorage.getItem(scaleKey))
      if (saved >= minScale && saved <= maxScale && saved % step === 0) scale = saved
    } catch {}

    function showScale() {
      face.style.setProperty('--clock-scale', String(scale / 100))
      size.value = `${scale}%`
      smaller.disabled = scale === minScale
      larger.disabled = scale === maxScale
    }

    function changeScale(amount: number) {
      scale = Math.min(maxScale, Math.max(minScale, scale + amount))
      showScale()
      try {
        localStorage.setItem(scaleKey, String(scale))
      } catch {}
    }

    showScale()
    smaller.addEventListener('click', () => changeScale(-step))
    larger.addEventListener('click', () => changeScale(step))

    const theme = document.documentElement.dataset

    function updateThemeButton() {
      themeButton.textContent = (theme.theme === 'dark' ? themeButton.dataset.light : themeButton.dataset.dark) ?? ''
    }

    updateThemeButton()
    themeButton.addEventListener('click', () => {
      theme.theme = theme.theme === 'dark' ? 'light' : 'dark'
      updateThemeButton()
      try {
        localStorage.setItem('theme', theme.theme)
      } catch {}
    })

    let controlsTimer: number

    function hideControls() {
      window.clearTimeout(controlsTimer)
      clock?.removeAttribute('data-controls-visible')
    }

    function dismissControls() {
      controls.querySelector<HTMLElement>(':focus')?.blur()
      hideControls()
    }

    function showControls() {
      clock?.setAttribute('data-controls-visible', '')
      window.clearTimeout(controlsTimer)
      controlsTimer = window.setTimeout(hideControls, 4000)
    }

    const fullscreenWindow = window.matchMedia('(display-mode: fullscreen)')
    controls.hidden = false
    if (!fullscreenWindow.matches) showControls()
    clock.addEventListener('pointermove', showControls)
    clock.addEventListener('pointerdown', showControls)
    controls.addEventListener('click', showControls)
    window.addEventListener('resize', hideControls)
    fullscreenWindow.addEventListener('change', ({ matches }) => {
      if (matches) dismissControls()
    })

    if (document.fullscreenEnabled) {
      fullscreenButton.hidden = false
      fullscreenButton.addEventListener('click', async () => {
        try {
          if (document.fullscreenElement === clock) {
            await document.exitFullscreen()
          } else {
            await clock.requestFullscreen()
          }
        } catch {
          showControls()
        }
      })
      document.addEventListener('fullscreenchange', () => {
        const fullscreen = document.fullscreenElement === clock
        fullscreenButton.textContent = (fullscreen ? fullscreenButton.dataset.exit : fullscreenButton.dataset.enter) ?? ''
        if (fullscreen) {
          dismissControls()
        } else {
          showControls()
        }
      })
    }
  }
</script>

<style>
  .clock {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--paper);
    color: var(--ink);
    font-feature-settings: normal;
  }
  .clock-time {
    font-size: calc(min(16.4vw, 54vh) * var(--clock-scale, 1));
    font-size: calc(min(16.4vw, 54dvh) * var(--clock-scale, 1));
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.045em;
    line-height: 1;
    white-space: nowrap;
  }
  .clock-controls {
    position: absolute;
    inset: max(clamp(0.75rem, 2.2vw, 1.75rem), env(safe-area-inset-top)) 0 auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: 'home meta settings';
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem clamp(0.65rem, 2.2vw, 1.35rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .clock [hidden] {
    display: none;
  }
  .clock:not([data-controls-visible]) .clock-controls:not(:has(:focus-visible)) {
    opacity: 0;
    pointer-events: none;
  }
  .clock-home {
    grid-area: home;
    display: inline-flex;
    justify-self: start;
    align-items: center;
    min-height: 2.75rem;
    border-radius: 0.65rem;
    text-decoration: none;
  }
  .clock-meta {
    grid-area: meta;
    display: grid;
    justify-items: center;
    gap: 0.12rem;
    line-height: 1.35;
  }
  .clock-zone {
    color: var(--link);
    font-size: var(--t-sm);
    font-weight: 750;
    letter-spacing: 0.08em;
  }
  .clock-source {
    color: var(--ink-soft);
    font-size: 0.75rem;
  }
  .clock-settings {
    grid-area: settings;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
    font-size: var(--t-sm);
  }
  .clock-size {
    display: flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 0.7rem;
    background: var(--surface-toned);
  }
  .clock-size output {
    min-width: 4.5ch;
    font-weight: 690;
    text-align: center;
  }
  .clock-step {
    width: 2.75rem;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 0.65rem;
    background: transparent;
    color: var(--ink);
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
  }
  .clock-step:hover:not(:disabled) {
    background: var(--surface);
  }
  .clock-step:disabled {
    opacity: 0.45;
    cursor: default;
  }
  .clock-control {
    min-height: calc(2.75rem + 2px);
    padding: 0.4rem 0.65rem;
    white-space: nowrap;
    cursor: pointer;
  }
  @media (max-width: 850px) {
    .clock-controls {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'home meta' 'settings settings';
      row-gap: 0.55rem;
    }
    .clock-meta {
      justify-items: end;
      text-align: end;
    }
    .clock-settings {
      justify-content: flex-start;
      border-top: 1px solid var(--line);
      padding-top: 0.55rem;
    }
  }
  @media (max-width: 370px) {
    .clock-size {
      flex-basis: 100%;
      justify-content: space-between;
    }
    .clock-control {
      flex: 1;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .clock:not([data-controls-visible]) {
      cursor: none;
    }
  }
</style>
