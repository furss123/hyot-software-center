---
import Base from '../../layouts/Base.astro'
import { localeStaticPaths, path, type Locale } from '../../lib/i18n'

export const getStaticPaths = localeStaticPaths

const locale = Astro.params.locale as Locale
const korean = locale === 'ko'
const title = korean ? '오늘 학교' : 'School Today'
const description = korean
  ? '학교와 학년·반을 등록하고, 날짜별 시간표와 급식 메뉴를 한 화면에서 확인하세요.'
  : 'Choose your school and class to view the daily timetable and meal menus together.'
const revision = '2.1.1'
const assets = '/today-school-assets'
---

<Base locale={locale} title={title} description={description} ads={false}>
  <section class="wrap school-page" aria-labelledby="school-page-title">
    <header class="page-heading">
      <div class="page-title">
        <img src={`${assets}/icon.svg?v=${revision}`} width="54" height="54" alt="" />
        <h1 id="school-page-title">{title}</h1>
      </div>
      <a class="btn" href={path(locale, 'software/today-meal')}>
        {korean ? 'Windows·Android 다운로드' : 'Windows & Android downloads'} <span aria-hidden="true">↓</span>
      </a>
    </header>
    <div id="today-school-web" lang="ko">
      <template shadowrootmode="open">
        <link rel="stylesheet" href={`${assets}/css/app.css?v=${revision}`} />
        <div id="app" class="app">
          <noscript><p class="file-help">오늘 학교를 사용하려면 JavaScript를 켜 주세요.</p></noscript>
        </div>
      </template>
    </div>
  </section>
  <script is:inline type="module" src={`${assets}/js/app.js?v=${revision}`}></script>
</Base>

<style>
  .school-page {
    padding-block: clamp(1.25rem, 3.5vw, 2.3rem) clamp(2rem, 5vw, 3.5rem);
  }
  .page-heading,
  .page-title {
    display: flex;
    align-items: center;
  }
  .page-heading {
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .7rem 1.2rem;
    margin-bottom: clamp(.85rem, 2vw, 1.2rem);
  }
  .page-title {
    gap: .75rem;
  }
  .page-title img {
    width: clamp(40px, 6vw, 54px);
    flex: none;
  }
  .page-title h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
  }
  .page-heading .btn {
    min-height: 2.45rem;
    padding: .45rem .7rem;
    font-size: var(--t-sm);
  }
</style>
