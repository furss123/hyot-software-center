---
import Base from '../../layouts/Base.astro'
import ToolHeading from '../../components/ToolHeading.astro'
import cover from '../../content/software/today-meal/cover.webp'
import { localeStaticPaths, path, t, type Locale } from '../../lib/i18n'
import { ogImageFor, webApplication } from '../../lib/seo'
import { appIcons, appScope } from '../../lib/today-school-app'

export const getStaticPaths = localeStaticPaths

const locale = Astro.params.locale as Locale
const korean = locale === 'ko'
const title = korean ? '오늘 학교' : 'School Today'
const description = korean
  ? '학교와 학년·반을 등록하고, 날짜별 시간표와 급식 메뉴를 한 화면에서 확인하세요.'
  : 'Choose your school and class to view the daily timetable and meal menus together.'
const revision = '2.1.1'
const assets = '/today-school-assets'
const ogImage = await ogImageFor(cover)
const jsonLd = webApplication({ name: title, description, path: Astro.url.pathname, category: 'classroom', image: ogImage })
const icons = await appIcons()
---

<Base
  locale={locale}
  title={`${title} – ${t(locale, 'seo.school')}`}
  description={description}
  image={ogImage}
  jsonLd={jsonLd}
  manifest={`${appScope(locale)}manifest.webmanifest`}
  appleTouchIcon={icons[180]}
  ads={false}
>
  <section class="wrap school-page" aria-labelledby="school-page-title">
    <ToolHeading
      id="school-page-title"
      title={title}
      description={description}
      action={{
        href: path(locale, 'software/today-school'),
        label: korean ? 'Windows·Android 앱 다운로드' : 'Download the Windows & Android apps',
      }}
    />
    <div id="today-school-web" lang="ko">
      <template shadowrootmode="open">
        <link rel="stylesheet" href={`${assets}/css/app.css?v=${revision}`} />
        <div id="app" class="app">
          <noscript><p class="file-help">오늘 학교를 사용하려면 JavaScript를 켜 주세요.</p></noscript>
        </div>
      </template>
    </div>
  </section>
  <script is:inline type="module" src={`${assets}/js/app.js?v=${revision}`}></script>
  <script is:inline>
    // 홈 화면에 설치해 앱처럼 쓰고, 인터넷이 잠깐 끊겨도 화면이 열리게 한다. (sw.js는 이 페이지 폴더에 있다)
    if ('serviceWorker' in navigator) navigator.serviceWorker.register('sw.js').catch(() => {})
  </script>
</Base>

<style>
  .school-page {
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2rem, 5vw, 3.5rem);
  }
</style>
