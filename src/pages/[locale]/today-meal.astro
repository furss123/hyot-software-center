---
import Base from '../../layouts/Base.astro'
import { localeStaticPaths, path, type Locale } from '../../lib/i18n'

export const getStaticPaths = localeStaticPaths

const locale = Astro.params.locale as Locale
const korean = locale === 'ko'
const title = korean ? '오늘 급식' : 'Today Meal'
const description = korean
  ? '학교를 등록하고 오늘의 조식, 중식, 석식을 브라우저에서 확인하세요.'
  : 'Register your school and check today’s breakfast, lunch, and dinner menus in your browser.'
---

<Base locale={locale} title={title} description={description}>
  <section class="wrap meal-page" aria-labelledby="meal-page-title">
    <header class="page-heading">
      <h1 id="meal-page-title">{title}</h1>
      <a class="btn downloads" href={path(locale, 'software/today-meal')}>
        {korean ? 'Windows·Android 다운로드' : 'Windows & Android downloads'}
      </a>
    </header>
    <div id="today-meal-web" lang="ko">
      <template shadowrootmode="open">
        <link rel="stylesheet" href="/today-meal-assets/css/app.css?v=2" />
        <div id="app" class="app">
          <noscript><p class="hint">급식을 보려면 JavaScript를 켜 주세요.</p></noscript>
        </div>
        <div id="toast" class="toast" role="status" aria-live="polite"></div>
      </template>
    </div>
  </section>
  <script is:inline type="module" src="/today-meal-assets/js/app.js?v=2"></script>
</Base>

<style>
  .meal-page {
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2.75rem, 7vw, 5rem);
  }
  .page-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.85rem 1.5rem;
    margin-bottom: clamp(1rem, 3vw, 1.75rem);
  }
  h1 {
    font-size: clamp(2.3rem, 5.4vw, 4rem);
    letter-spacing: -0.065em;
  }
  .downloads {
    font-size: var(--t-sm);
  }
  :global(body.today-meal-modal) {
    overflow: hidden;
  }
</style>
