---
import Base from '../layouts/Base.astro'
import { t, path } from '../lib/i18n'

const locale = 'ko' as const
---

{/* 어느 언어 주소에서 왔는지 알 수 없으므로 한국어와 영어를 함께 보여 준다. 오류 페이지에는 광고를 넣지 않는다(애드센스 정책). */}
<Base locale={locale} title={t(locale, 'notfound.title')} ads={false}>
  <div class="wrap">
    <section class="error" aria-labelledby="error-title">
      <span class="code" aria-hidden="true">404</span>
      <h1 id="error-title">{t(locale, 'notfound.title')}</h1>
      <p>{t(locale, 'notfound.body')}</p>
      <p class="en" lang="en">{t('en', 'notfound.title')}. {t('en', 'notfound.body')}</p>
      <div class="links">
        <a class="btn btn-primary" href={path('ko')}><span aria-hidden="true">←</span> {t('ko', 'notfound.cta')}</a>
        <a class="btn" href={path('en')} lang="en">English home</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .error {
    margin-top: clamp(1.25rem, 5vw, 4rem);
    padding: clamp(1.65rem, 7vw, 5.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .code {
    color: var(--link);
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 850;
    letter-spacing: -0.075em;
    line-height: 1;
  }
  h1 {
    margin-block: 0.6rem 0.7rem;
    font-size: var(--t-lg);
  }
  p {
    color: var(--ink-soft);
  }
  .en {
    margin-top: 0.3rem;
    font-size: var(--t-sm);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.35rem;
  }
</style>
